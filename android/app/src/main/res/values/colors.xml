<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Prayer Fire "Evergreen" palette (mirrors src/app/globals.css).
         styles.xml references these; without this file AAPT2 cannot resolve them. -->
    <color name="colorPrimary">#047857</color>
    <color name="colorPrimaryDark">#065F46</color>
    <color name="colorAccent">#047857</color>
    <!-- Status bar behind the evergreen top bar (the night version is in values-night). -->
    <color name="status_bar">#053D2E</color>
    <!-- The one start-up colour: the system splash, the window and the web view all use it, and it is the same as the
         page colour the web app's own boot animation starts on, so there is only ONE visible start-up (night version
         in values-night). -->
    <color name="splash_bg">#F0E9DA</color>
</resources>
