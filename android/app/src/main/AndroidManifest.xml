<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Prayer Fire Movement — Android manifest

      The WebView loads https://prayer-fire.vercel.app (see capacitor.config.ts),
      so every web deploy ships instantly without a Play Store update. What the
      native layer adds is exactly what the web cannot do on its own:
      real alarms that fire while the phone is asleep / the app is closed,
      and notifications that survive a reboot.
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ runtime permission — the app asks on first alarm setup. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12+ exact alarms, so the 4 AM prayer watch rings at 4:00:00. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Re-schedule every alarm after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ── "Ring like an alarm" native alarm engine ──────────────────── -->
    <!-- Android 14+ runtime-grantable permission for the full-screen ringing UI. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The foreground service that plays the alarm tone for 3 minutes. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
      Lets us ask the user to exempt the app from battery optimization.
      Justified here (per Play policy's "core functionality" carve-out): the
      whole feature is time-critical alarms, and Samsung/Xiaomi-style OEM
      battery managers are known to kill background alarms even when
      AlarmManager + a foreground service are both used correctly.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- ── Native "Ring like an alarm" engine ─────────────────────── -->
        <receiver
            android:name=".alarmengine.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarmengine.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".alarmengine.AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name=".alarmengine.AlarmRingActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:theme="@style/AppTheme.NoActionBarLaunch" />
    </application>

</manifest>
